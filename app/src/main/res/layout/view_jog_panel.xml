<?xml version="1.0" encoding="utf-8"?>

<!-- Jog page, portrait: step and speed chips, dial, stop. -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        style="@style/LdLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STEP (mm)" />

    <com.laserdroid.ui.common.ChoiceChipsView
        android:id="@+id/chipsJogStep"
        android:layout_width="match_parent"
        android:layout_height="46dp" />

    <TextView
        style="@style/LdLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SPEED (mm/min)" />

    <com.laserdroid.ui.common.ChoiceChipsView
        android:id="@+id/chipsJogSpeed"
        android:layout_width="match_parent"
        android:layout_height="46dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="6dp">

            <com.laserdroid.ui.jog.JogDialView
                android:id="@+id/jogDial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/columnJogZ"
            android:layout_width="68dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/buttonJogZUp"
                style="@style/LdButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_arrow_up"
                android:text="Z+" />

            <TextView
                android:id="@+id/buttonJogZDown"
                style="@style/LdButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_arrow_down"
                android:text="Z-" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/buttonSetZero"
            style="@style/LdButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_my_location"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="SET ZERO" />

        <TextView
            android:id="@+id/buttonLaserPointer"
            style="@style/LdButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_flash"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="LASER 2%" />

    </LinearLayout>

    <TextView
        android:id="@+id/buttonJogCancel"
        style="@style/LdButton.Danger"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:drawableStart="@drawable/ic_close"
        android:paddingStart="24dp"
        android:paddingEnd="48dp"
        android:text="STOP JOG" />

</LinearLayout>
