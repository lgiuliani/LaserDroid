<?xml version="1.0" encoding="utf-8"?>

<!-- Jog page, portrait: step and speed chips, dial, stop. -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        style="@style/LdLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STEP (mm)" />

    <com.laserdroid.ui.common.ChoiceChipsView
        android:id="@+id/chipsJogStep"
        android:layout_width="match_parent"
        android:layout_height="46dp" />

    <TextView
        style="@style/LdLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SPEED (mm/min)" />

    <com.laserdroid.ui.common.ChoiceChipsView
        android:id="@+id/chipsJogSpeed"
        android:layout_width="match_parent"
        android:layout_height="46dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="6dp">

        <com.laserdroid.ui.jog.JogDialView
            android:id="@+id/jogDial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

    </FrameLayout>

    <TextView
        android:id="@+id/buttonJogCancel"
        style="@style/LdButton.Danger"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:drawableStart="@drawable/ic_close"
        android:paddingStart="24dp"
        android:paddingEnd="48dp"
        android:text="STOP JOG" />

</LinearLayout>
