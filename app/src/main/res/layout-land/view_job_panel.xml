<?xml version="1.0" encoding="utf-8"?>

<!-- Job page, landscape: preview left, controls right (compact buttons). -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="4dp">

    <com.laserdroid.ui.job.GCodePreviewView
        android:id="@+id/jobPreview"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:orientation="vertical"
        android:paddingStart="6dp">

        <TextView
            android:id="@+id/textJobInfo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="2dp"
            android:text="No program loaded"
            android:textColor="@color/ld_text_secondary"
            android:textSize="10sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/textJobStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:text="EMPTY"
            android:textSize="12sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <ProgressBar
            android:id="@+id/progressJob"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="2dp"
            android:max="1000"
            android:progressTint="@color/ld_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal">

            <Switch
                android:id="@+id/checkJobLaserOff"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:checked="true"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:text="Laser OFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchJobAir"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_air"
                android:drawablePadding="4dp"
                android:drawableTint="@color/ld_text"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:text="Air (M8)"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonJobOpen"
                style="@style/LdButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_folder_open"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:drawablePadding="0dp"
                android:textSize="10sp"
                android:text="OPEN" />

            <TextView
                android:id="@+id/buttonJobFrame"
                style="@style/LdButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_frame"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:drawablePadding="0dp"
                android:textSize="10sp"
                android:text="FRAME" />

            <TextView
                android:id="@+id/buttonJobCenter"
                style="@style/LdButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_center"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:drawablePadding="0dp"
                android:textSize="10sp"
                android:text="CENTER" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonJobStart"
                style="@style/LdButton.Primary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:drawableTop="@drawable/ic_play"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:drawablePadding="0dp"
                android:textSize="10sp"
                android:text="START" />

            <TextView
                android:id="@+id/buttonJobPause"
                style="@style/LdButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_pause"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:drawablePadding="0dp"
                android:textSize="10sp"
                android:text="PAUSE" />

            <TextView
                android:id="@+id/buttonJobResume"
                style="@style/LdButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_play"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:drawablePadding="0dp"
                android:textSize="10sp"
                android:text="RESUME" />

            <TextView
                android:id="@+id/buttonJobStop"
                style="@style/LdButton.Danger"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:drawableTop="@drawable/ic_stop"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:drawablePadding="0dp"
                android:textSize="10sp"
                android:text="STOP" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
