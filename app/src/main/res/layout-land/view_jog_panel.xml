<?xml version="1.0" encoding="utf-8"?>

<!-- Jog page, landscape: dial on the left, settings on the right. -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="2dp">

        <com.laserdroid.ui.jog.JogDialView
            android:id="@+id/jogDial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp">

        <TextView
            style="@style/LdLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STEP (mm)" />

        <com.laserdroid.ui.common.ChoiceChipsView
            android:id="@+id/chipsJogStep"
            android:layout_width="match_parent"
            android:layout_height="46dp" />

        <TextView
            style="@style/LdLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SPEED (mm/min)" />

        <com.laserdroid.ui.common.ChoiceChipsView
            android:id="@+id/chipsJogSpeed"
            android:layout_width="match_parent"
            android:layout_height="46dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/buttonJogCancel"
            style="@style/LdButton.Danger"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:drawableStart="@drawable/ic_close"
            android:paddingStart="24dp"
            android:paddingEnd="48dp"
            android:text="STOP JOG" />

    </LinearLayout>

</LinearLayout>
