<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="6dp">

    <!-- Left side -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:orientation="vertical"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="3dp"
            android:text="LaserDroid"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonDetectUsb"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Detect"
                android:textSize="8sp" />

            <Button
                android:id="@+id/buttonConnectUsb"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Connect"
                android:textSize="8sp" />

            <Button
                android:id="@+id/buttonStatus"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Status"
                android:textSize="8sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonSettings"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Settings"
                android:textSize="8sp" />

            <Button
                android:id="@+id/buttonBuildInfo"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="GRBL Info"
                android:textSize="8sp" />

            <Button
                android:id="@+id/buttonClearLog"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Clear"
                android:textSize="8sp" />

        </LinearLayout>

        <com.laserdroid.ui.jog.JogPanelView
            android:id="@+id/jogPanel"
            android:layout_width="match_parent"

            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Right side : LOG -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.85"
        android:orientation="vertical"
        android:paddingStart="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="3dp"
            android:text="LOG"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/logScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#101010"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/textUsbDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:textColor="#E8E8E8"
                android:textIsSelectable="true"
                android:textSize="9sp"
                android:typeface="monospace" />

        </ScrollView>

    </LinearLayout>

</LinearLayout>